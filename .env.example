# ==============================================================================
# SPENDLY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret (64-character random secret recommended in production)
JWT_SECRET=spendly_super_secure_jwt_secret_key_2026_prod

# Persistent SQLite Database Location
DB_PATH=./server/spendly.db

# ------------------------------------------------------------------------------
# BREVO REAL TRANSACTIONAL EMAIL / OTP CONFIGURATION
# ------------------------------------------------------------------------------
# Spendly uses Brevo (formerly Sendinblue) SMTP for real email OTP delivery.
# Credentials must remain server-side and are NEVER exposed to the frontend.
#
# Steps to configure:
# 1. Create a free account at https://www.brevo.com (300 free emails/day).
# 2. Go to Settings -> Senders, Domains & Dedicated IPs -> Senders.
#    Verify your sender email address (e.g. your Brevo account email).
# 3. Go to SMTP & API -> SMTP tab.
# 4. Generate an SMTP Master Key (starts with xsmtpsib-...).
# 5. Populate the variables below:

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=xsmtpsib-your_brevo_smtp_key
SMTP_FROM=Spendly <your_verified_sender_email@domain.com>
# Optional: Brevo REST API v3 key (starts with xkeysib-...) for API fallback
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# WEB PUSH NOTIFICATION CONFIGURATION (VAPID)
# ------------------------------------------------------------------------------
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@spendly.app
